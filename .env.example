# Required — absolute path to the local SQLite database file (Prisma).
DATABASE_URL="file:/home/z/my-project/apps/04-readme-generator/db/custom.db"

# Optional — disables live LLM and uses a deterministic mock provider.
# Useful for offline development and tests.
PKC_DISABLE_LLM=0

# Optional — override the unauthenticated GitHub REST API base URL.
# Defaults to https://api.github.com
GITHUB_API_BASE=https://api.github.com

# Optional — GitHub token (NOT used in MVP; documented for stretch).
# Increases rate limit from 60 req/hr to 5,000 req/hr.
# GITHUB_TOKEN=ghp_xxx
